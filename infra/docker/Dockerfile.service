FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json package-lock.json* ./
ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/package.json ./services/${SERVICE_NAME}/
RUN cd services/${SERVICE_NAME} && npm install

# Build
FROM base AS builder
ARG SERVICE_NAME
COPY --from=deps /app/services/${SERVICE_NAME}/node_modules ./services/${SERVICE_NAME}/node_modules
COPY services/${SERVICE_NAME} ./services/${SERVICE_NAME}
RUN cd services/${SERVICE_NAME} && npx tsc || true

# Runner
FROM base AS runner
ARG SERVICE_NAME
ENV NODE_ENV=production
RUN mkdir -p /app/data /app/uploads
COPY --from=deps /app/services/${SERVICE_NAME}/node_modules ./node_modules
COPY services/${SERVICE_NAME}/src ./src
COPY services/${SERVICE_NAME}/package.json ./
# Use tsx for running TypeScript directly in POC
RUN npm install -g tsx
EXPOSE 3000
CMD ["tsx", "src/index.ts"]
