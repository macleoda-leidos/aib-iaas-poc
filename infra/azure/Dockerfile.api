# AiB IAAS - Consolidated API Container
# Runs all 11 backend services in a single Express process

FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies (including native build tools for better-sqlite3)
FROM base AS deps
RUN apk add --no-cache python3 make g++
WORKDIR /app
# Copy root package.json and lockfile for workspace resolution
COPY package.json package-lock.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/integration-contracts/package.json ./packages/integration-contracts/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/statutory/package.json ./packages/statutory/
COPY packages/validation/package.json ./packages/validation/
COPY services/consolidated-api/package.json ./services/consolidated-api/
# recommendation-service declares @aib-iaas/statutory and the consolidated API
# imports its rules engine, so this manifest must be present for npm to create
# the workspace symlink under node_modules. Copying the package source alone is
# not enough — without the link, require('@aib-iaas/statutory') from a service
# directory cannot resolve, which is exactly how this broke.
COPY services/recommendation-service/package.json ./services/recommendation-service/
RUN npm ci --workspace=packages/database --workspace=packages/integration-contracts --workspace=packages/statutory --workspace=services/recommendation-service --workspace=services/consolidated-api --include-workspace-root 2>/dev/null || npm install --omit=dev

# Copy source and run
FROM base AS runner
ENV NODE_ENV=production
RUN apk add --no-cache tini && mkdir -p /data/uploads

# Copy node_modules (includes compiled native modules)
COPY --from=deps /app/node_modules ./node_modules

# Copy all service source code and packages
COPY services/ ./services/
COPY packages/ ./packages/
COPY package.json ./

# Install tsx globally
RUN npm install -g tsx

WORKDIR /app/services/consolidated-api
EXPOSE 3001

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["tsx", "src/index.ts"]
