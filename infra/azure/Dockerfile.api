# AiB IAAS - Consolidated API Container
# Runs all 11 backend services in a single Express process
# Optimised for Azure Container Apps free tier

FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY services/consolidated-api/package.json ./package.json
RUN npm install --omit=dev

# Copy source and run
FROM base AS runner
ENV NODE_ENV=production
RUN apk add --no-cache tini && mkdir -p /data/uploads

# Copy installed node_modules
COPY --from=deps /app/node_modules ./node_modules

# Copy all service source code
COPY services/ ./services/
COPY packages/ ./packages/

# Install tsx globally for running TypeScript
RUN npm install -g tsx

WORKDIR /app/services/consolidated-api
EXPOSE 3001

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["tsx", "src/index.ts"]
