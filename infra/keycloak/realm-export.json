  "identityProviders": [
    {
      "alias": "scotaccount",
      "displayName": "myaccount.scotaccount.gov.scot",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "singleSignOnServiceUrl": "https://scotaccount.gov.scot/saml2/idp/SSOService.php",
        "singleLogoutServiceUrl": "https://scotaccount.gov.scot/saml2/idp/SingleLogoutService.php",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "entityId": "https://iaas.aib.gov.uk/auth/realms/aib-iaas",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "KEY_ID",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "forceAuthn": "false",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "validateSignature": "true",
        "principalType": "ATTRIBUTE",
        "principalAttribute": "email"
      }
    },
    {
      "alias": "govuk-login",
      "displayName": "GOV.UK One Login",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://signin.account.gov.uk/authorize",
        "tokenUrl": "https://signin.account.gov.uk/token",
        "userInfoUrl": "https://signin.account.gov.uk/userinfo",
        "logoutUrl": "https://signin.account.gov.uk/logout",
        "issuer": "https://signin.account.gov.uk",
        "clientId": "placeholder-client-id",
        "clientSecret": "placeholder-client-secret",
        "defaultScope": "openid email",
        "syncMode": "IMPORT",
        "clientAuthMethod": "client_secret_post",
        "backchannelSupported": "false",
        "useJwksUrl": "true",
        "jwksUrl": "https://signin.account.gov.uk/.well-known/jwks.json"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "iaas-roles",
      "description": "IAAS application roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Your application roles"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "iaas-roles"
  ],
  "browserFlow": "browser",
