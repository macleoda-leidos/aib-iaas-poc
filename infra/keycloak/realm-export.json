{
  "id": "aib-iaas",
  "realm": "aib-iaas",
  "displayName": "AiB Initial Application Advice Service",
  "displayNameHtml": "<strong>AiB</strong> Initial Application Advice Service",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "maxFailureWaitSeconds": 300,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 300,
  "failureFactor": 3,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v2",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "internationalizationEnabled": false,
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "system_admin",
        "description": "Full system administration access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "aib_senior_officer",
        "description": "AiB Senior Case Officer - can approve, reject, escalate",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "aib_case_officer",
        "description": "AiB Case Officer - can review and process applications",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "money_adviser",
        "description": "Approved Money Adviser - can submit applications on behalf of debtors",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "creditor",
        "description": "Creditor - can view and respond to applications involving their debts",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "supplier_trustee",
        "description": "Supplier Trustee - can manage assigned cases",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "debtor",
        "description": "Debtor - can create and track their own applications",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "statistician",
        "description": "Statistician - read-only access to anonymised reports and analytics",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "cyberops_analyst",
        "description": "Cyber Operations Analyst - security monitoring and audit access",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "iaas-web",
      "name": "IAAS Web Portal",
      "description": "Public-facing Next.js web application for applicants",
      "enabled": true,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://macleoda-leidos.github.io/*"
      ],
      "webOrigins": ["+"],
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "adminUrl": "http://localhost:3000",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://macleoda-leidos.github.io/*"
      }
    },
    {
      "clientId": "iaas-admin",
      "name": "IAAS Admin Portal",
      "description": "Internal admin portal for AiB staff",
      "enabled": true,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3010/*",
        "https://macleoda-leidos.github.io/*"
      ],
      "webOrigins": ["+"],
      "rootUrl": "http://localhost:3010",
      "baseUrl": "/",
      "adminUrl": "http://localhost:3010",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3010/*##https://macleoda-leidos.github.io/*"
      }
    },
    {
      "clientId": "iaas-api",
      "name": "IAAS API Gateway",
      "description": "Backend API Gateway - validates bearer tokens",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "iaas-api-secret-change-in-production",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
