# AiB IAAS POC - Environment Configuration
NODE_ENV=development

# Database
DATABASE_URL=postgresql://iaas:iaas_dev@localhost:5432/iaas
DATABASE_PATH=./data/iaas.db

# Access-token signing (Ed25519). Generate a pair with: npm run auth:keygen
#
# Leave unset for a single-process run (the consolidated API, or the test suite): a
# keypair is generated at boot with a warning, tokens are still signed and verified,
# but they do not survive a restart.
#
# REQUIRED when running the twelve services as separate processes (npm run dev:services),
# because user-service mints tokens that api-gateway must verify — with per-process
# ephemeral keys each would reject the other's tokens. Also required in any deployed
# environment, so that a redeploy does not log every user out.
#
# Accepts PEM or base64-wrapped PEM (use base64 for dashboards that mangle newlines).
# JWT_PRIVATE_KEY can mint any session — treat it as a secret and never commit it.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aib-iaas
KEYCLOAK_CLIENT_ID=iaas-web
KEYCLOAK_CLIENT_SECRET=

# Integration Mode (mock or live)
INTEGRATION_MODE=mock
MOCK_FAILURE_RATE=0
MOCK_LATENCY_MIN_MS=50
MOCK_LATENCY_MAX_MS=200

# Services
API_GATEWAY_URL=http://localhost:3001
RECOMMENDATION_SERVICE_URL=http://localhost:3002
DOCUMENT_SERVICE_URL=http://localhost:3003
INTEGRATION_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3006
AUDIT_SERVICE_URL=http://localhost:3007

# Document Storage
UPLOAD_PATH=./uploads
SCANNER_MODE=auto
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=

# Service Ports
PORT_API_GATEWAY=3001
PORT_RECOMMENDATION=3002
PORT_DOCUMENT=3003
PORT_INTEGRATION=3004
PORT_MOCK_INTEGRATIONS=3005
PORT_PAYMENT=3006
PORT_AUDIT=3007
PORT_WEB=3000
PORT_ADMIN=3010

# AI Recommendation (placeholder)
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:3020

# Payment (sandbox/placeholder)
PAYMENT_MODE=sandbox
