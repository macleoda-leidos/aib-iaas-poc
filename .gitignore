node_modules/
dist/
.next/
.env
.env.local
*.db
# SQLite in WAL mode writes two sidecars beside the database, and *.db alone does
# not match them — they linger after any local run of the .NET API.
*.db-shm
*.db-wal
*.sqlite
uploads/
coverage/
.turbo/
.DS_Store
Thumbs.db
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
# Runtime database files (not source code data/ directories)
/data/
services/*/data/

# .NET build artifacts
#
# Path-scoped rather than a bare `bin/`, which would also match anything named bin under
# apps/ or packages/. These two patterns cover every .NET project in the repo — the API and
# its test project — and a new one needs adding here, because `dotnet test` writes ~180 files
# into bin/ and obj/ that will otherwise be picked up by `git add -A`.
services/dotnet-api/bin/
services/dotnet-api/obj/
tests/dotnet/**/bin/
tests/dotnet/**/obj/

# Build artifacts
apps/web/out/
apps/web/.netlify/
apps/web/apps/
apps/web/tsconfig.tsbuildinfo
apps/admin/tsconfig.tsbuildinfo
services/**/*.js.map
services/**/*.js
!services/**/vitest.config.js
packages/shared-types/src/**/*.js
packages/shared-types/src/**/*.js.map
.claude/worktrees/
