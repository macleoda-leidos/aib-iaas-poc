    APPLICATION {
        string id PK
        string referenceNumber UK
        string status
        datetime createdAt
        datetime updatedAt
        datetime submittedAt
    }

    DEBTOR_DETAILS {
        string firstName
        string lastName
        string dateOfBirth
        string nationalInsuranceNumber
        string employmentStatus
        string maritalStatus
        int dependants
    }

    DEBT {
        string creditorName
        string creditorType
        decimal originalAmount
        decimal outstandingAmount
        decimal monthlyPayment
        boolean isSecured
        boolean inArrears
    }

    PRODUCT_RECOMMENDATION {
        string recommendedProduct
        string confidence
        json reasoning
        json alternativeProducts
        json factors
    }

    USER {
        string id PK
        string email UK
        string firstName
        string lastName
        string role
        string status
        boolean mfaEnabled
    }

    ROLE {
        string name PK
        string displayName
        int level
    }
